# Nusxa oling:  cp .env.example .env   (keyin qiymatlarni to'ldiring)
# DIQQAT: .env fayli hech qachon git'ga qo'shilmasin — u .gitignore da.

# @BotFather dan olingan token. MAJBURIY.
ANON_BOT_TOKEN=

# Bot egasining Telegram chat_id si. MAJBURIY — kodda default qiymat yo'q.
# O'z ID'ingizni bilish uchun Telegram'da @userinfobot ga /start yozing.
SUPER_ADMIN_ID=

# Ixtiyoriy: qo'shimcha adminlar, vergul bilan ajratilgan chat_id lar.
# Masalan: ADMIN_IDS=111111111,222222222
ADMIN_IDS=
